# Public origin used for canonical/hreflang/sitemap. NOT verified as owned — set when the domain is confirmed.
SITE_URL=http://localhost:3000
PORT=3000
# Lead delivery: "dev" (default; stores to data/leads.jsonl, UI says it is NOT delivered), "webhook" or "email"
LEAD_ADAPTER=dev
# Required when LEAD_ADAPTER=webhook — CRM / Make / Zapier / n8n endpoint receiving the JSON lead
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# Required when LEAD_ADAPTER=email — every message is emailed to LEAD_EMAIL_TO through Resend (resend.com).
# Until a sending domain is verified in Resend, keep the default sender; Resend then only delivers to the
# address the Resend account was created with, so create the account with the same address as LEAD_EMAIL_TO.
RESEND_API_KEY=
LEAD_EMAIL_TO=
# LEAD_EMAIL_FROM="bee & co. website <hello@your-domain>"   # after verifying your domain in Resend
# Optional scheduling link (Calendly / Cal.com / etc.) shown after a successful submission
BOOKING_URL=
# Vercel only: search engines are blocked (robots.txt Disallow) until this is set to 1 after launch approvals
ALLOW_INDEXING=
